# الزامی
BOT_TOKEN=123456789:replace_with_real_token
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
ADMIN_IDS=466050034
CHANNEL_ID=-1001277492702

# برند و Mini App
CHANNEL_LINK=https://t.me/Ajor_pareh
SUPPORT_USERNAME=Ajorparehbot
MINI_APP_URL=https://ajor2-production.up.railway.app/app/
# اختیاری؛ از پنل مدیریت هم قابل تنظیم است.
SERVICE_PAYMENT_CARD=
SERVICE_PAYMENT_HOLDER=

# Railway به‌طور خودکار RAILWAY_PUBLIC_DOMAIN را می‌سازد.
# اگر دامنه سفارشی داری، مقدار زیر را ست کن (بدون / آخر).
# WEBHOOK_BASE_URL=https://your-service.up.railway.app
USE_WEBHOOK=true
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace_with_a_random_32_to_64_character_string

# ===== سرور لوکال Bot API (اختیاری ولی پیشنهادی) =====
# با فعال‌کردن این حالت، سقف فایل از ۵۰MB به ۲ گیگابایت افزایش می‌یابد و ربات
# به‌صورت long polling از طریق localhost کار می‌کند (وب‌هوک عمومی دیگر لازم نیست).
# api_id و api_hash را از https://my.telegram.org (بخش API development tools) بگیر.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# LOCAL_BOT_API=true
# USE_WEBHOOK=false
# MAX_MEDIA_BYTES_MB=1950

# ===== آب‌وهوا و کش =====
# کلید رایگان OpenWeatherMap (اختیاری — اگر نباشد از Open-Meteo بدون کلید استفاده می‌شود)
# OPENWEATHER_API_KEY=
# کش Redis از طریق Upstash (اختیاری — بدون آن کش حافظه‌ای فعال است)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ===== موزیک =====
# تشخیص آهنگ از تکه صدا (Shazam-like) — اختیاری؛ کلید رایگان از https://audd.io بگیر.
# AUDD_API_KEY=
# Fallback مدیریت‌شده Instagram برای کلیپ‌های عمومی که IP سرور را بلاک می‌کنند.
# کلید را هرگز داخل سورس/چت نگذار؛ فقط به‌صورت Railway Variable تنظیم کن.
# INSTAGRAM_MANAGED_PROVIDER=hiker
# HIKERAPI_TOKEN=
# یا برای fallback عمومی Apify:
# INSTAGRAM_MANAGED_PROVIDER=apify
# APIFY_TOKEN=
# INSTAGRAM_APIFY_ACTOR=apify~instagram-scraper
# برای Provider سازگار دیگر:
# INSTAGRAM_MANAGED_PROVIDER=custom
# INSTAGRAM_RESOLVER_API_URL=
# INSTAGRAM_RESOLVER_API_KEY=

# اختیاری
FORCE_JOIN=true

# هوش مصنوعی — کلیدها فقط در Railway Variables، هرگز داخل سورس/GitHub قرار نگیرند.
# ترتیب fallback متن: Gemini → Groq → Cerebras → OpenRouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
POLLINATIONS_IMAGE_ENABLED=true
POLLINATIONS_IMAGE_MODEL=flux
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
AI_DAILY_TEXT_LIMIT=25
AI_DAILY_IMAGE_LIMIT=2
AI_MAX_USER_TEXT_BONUS=200
AI_MAX_USER_IMAGE_BONUS=20
AI_MAX_REFERRAL_TEXT_BONUS=50
AI_REFERRAL_TEXT_BONUS=1
AI_REFERRAL_TEXT_BONUS_CAP=10
AI_PROVIDER_TIMEOUT_SECONDS=18
AI_TOTAL_TIMEOUT_SECONDS=45
AI_IMAGE_TIMEOUT_SECONDS=90
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=900
